# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Required for client-side Gemini fallback on static hosting (e.g. Vercel).
# If you deploy to a static frontend environment where the Express server is disabled,
# define this variable in your hosting panel (e.g. Vercel dashboard) to enable client-side AI chat.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BUILT-IN SOVEREIGN ANALYTICS:
# 100% Free, Self-Contained, and Cookie-Free. Runs directly on your Node backend (server.ts).
# Zero external tracking accounts, zero third-party dependencies, zero monthly costs.
# ADMIN_PASSWORD: Password for the Sovereign Analytics console.
# Defaults to "PeterOBI" if not specified.
ADMIN_PASSWORD="PeterOBI"
VITE_ADMIN_PASSWORD="PeterOBI"
